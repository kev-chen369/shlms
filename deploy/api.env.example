# Copy values into your deployment secret store; this file is not loaded automatically.
DATABASE_URL=postgres://USER:REPLACE_ME@HOST:5432/DB?sslmode=require
AUTH_PUBLIC_KEY_FILE=/absolute/path/to/access-token-public-key.pem
AUTH_ISSUER=https://your-token-issuer.example
AUTH_AUDIENCE=shlms-api
PROMOTER_AGREEMENT_VERSION=REPLACE_WITH_APPROVED_VERSION
API_ADDR=:8080
# Optional absolute path to a read-only regular JSON file; empty disables catalog reads.
# Invalid explicit configuration aborts startup; this file does not grant READY.
CATALOG_BINDINGS_FILE=
